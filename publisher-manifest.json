          "version": 3,
          "body": "<style>\n  :root{--wine:#6b1f2b;--wine-deep:#4a141d;--ivory:#f6f1e7;--ivory-soft:#efe7d8;--ink:#2b2320;--ink-soft:#5d5049;--line:#c9b9a3;--accent:#a8342f}\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{margin:0;background:var(--ivory);color:var(--ink);font-family:\"Songti SC\",\"SimSun\",\"Noto Serif SC\",Georgia,serif;font-size:16px;line-height:1.75}\n  a{color:var(--wine);text-decoration:none;border-bottom:1px solid rgba(107,31,43,.35)}\n  a:hover{color:var(--accent);border-bottom-color:var(--accent)}\n  .wrap{width:100%;max-width:1080px;margin:0 auto;padding:0 20px}\n\n  /* 首屏 */\n  .hero{background:var(--wine);color:var(--ivory);padding:48px 0 56px;border-bottom:6px solid var(--wine-deep)}\n  .kicker{display:inline-block;font-size:12px;letter-spacing:.28em;text-transform:uppercase;border:1px dashed rgba(246,241,231,.55);padding:4px 12px;margin:0 0 22px;color:var(--ivory-soft)}\n  .hero h1{font-size:clamp(30px,5.2vw,52px);line-height:1.25;margin:0 0 18px;letter-spacing:.02em;font-weight:700}\n  .hero p.lead{margin:0 0 30px;max-width:56ch;color:#f0e4d4;font-size:17px}\n  .dash{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n  .dash-cell{border:1px dashed rgba(246,241,231,.6);border-radius:0;padding:16px 14px 14px;background:rgba(74,20,29,.42)}\n  .dash-cell .label{display:block;font-size:12px;letter-spacing:.16em;color:#e3d2c1;margin-bottom:8px}\n  .dash-cell .value{display:block;font-size:26px;line-height:1.2;font-weight:700;color:#fff8ec}\n  .dash-cell .note{display:block;font-size:12.5px;color:#d9c3b0;margin-top:6px;line-height:1.5}\n  .hero-links{margin-top:28px;font-size:14.5px;color:#e3d2c1}\n  .hero-links a{color:var(--ivory);border-bottom:1px solid rgba(246,241,231,.5);margin-right:4px}\n  .hero-links span.sep{color:#b98d84;padding:0 8px}\n\n  /* 通用区块 */\n  section{padding:56px 0}\n  section + section{border-top:1px solid var(--line)}\n  h2{font-size:clamp(22px,3.2vw,30px);line-height:1.35;margin:0 0 10px;color:var(--wine-deep);letter-spacing:.01em}\n  h3{font-size:18px;margin:0 0 8px;color:var(--wine)}\n  .section-note{margin:0 0 32px;max-width:64ch;color:var(--ink-soft);font-size:15px}\n\n  /* 票据卡片 */\n  .ticket{border:1px dashed var(--line);background:var(--ivory-soft);padding:20px 20px 18px;margin:0}\n  .ticket .stub{display:flex;justify-content:space-between;align-items:baseline;gap:12px;border-bottom:1px dashed var(--line);padding-bottom:10px;margin-bottom:12px;font-size:12.5px;letter-spacing:.14em;color:var(--ink-soft)}\n  .three{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n\n  /* 流程 */\n  .steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:step}\n  .steps li{counter-increment:step;border:1px dashed var(--line);background:var(--ivory-soft);padding:18px}\n  .steps li::before{content:\"步骤 \" counter(step);display:block;font-size:12px;letter-spacing:.16em;color:var(--accent);margin-bottom:8px}\n  .steps li p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n  /* 套餐阶梯 */\n  .ladder{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start}\n  .rung{border:1px dashed var(--line);background:#fbf7ee;padding:22px 20px 20px;position:relative}\n  .rung-1{margin-top:0}\n  .rung-2{margin-top:26px}\n  .rung-3{margin-top:52px}\n  .rung .tier-no{font-size:12px;letter-spacing:.2em;color:var(--ink-soft)}\n  .rung h3{font-size:21px;margin:6px 0 2px;color:var(--wine-deep)}\n  .rung .price{font-size:26px;font-weight:700;color:var(--accent);line-height:1.3;margin:10px 0 2px}\n  .rung .annual{font-size:13.5px;color:var(--ink-soft);margin:0 0 14px}\n  .rung ul{list-style:none;margin:0;padding:14px 0 0;border-top:1px dashed var(--line);font-size:14.5px}\n  .rung ul li{position:relative;padding-left:16px;margin-bottom:9px;color:#3c322c}\n  .rung ul li::before{content:\"·\";position:absolute;left:2px;top:-1px;color:var(--accent);font-weight:700}\n  .flag{display:inline-block;font-size:11.5px;letter-spacing:.14em;background:var(--wine);color:var(--ivory);padding:2px 9px;margin-left:8px;vertical-align:middle;border-bottom:0}\n  .ladder-foot{margin-top:30px;font-size:14px;color:var(--ink-soft);border:1px dashed var(--line);padding:14px 18px;background:var(--ivory-soft)}\n  .ladder-foot strong{color:var(--wine-deep)}\n\n  /* 客户端 */\n  .client-list{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}\n  .client-list .ticket p{margin:0 0 10px;font-size:14.5px;color:var(--ink-soft)}\n  .client-list .ticket .meta{font-size:13px;color:var(--ink-soft);border-top:1px dashed var(--line);padding-top:10px;margin:0}\n  .meta a{color:var(--wine)}\n\n  /* FAQ */\n  .faq-group{margin-bottom:34px}\n  .faq-group:last-child{margin-bottom:0}\n  .faq-group > h3{font-size:15px;letter-spacing:.2em;color:var(--accent);border-bottom:1px solid var(--line);padding-bottom:8px;margin:0 0 18px}\n  .qa{border:1px dashed var(--line);background:#fbf7ee;padding:16px 18px;margin-bottom:14px}\n  .qa h4{font-size:16px;margin:0 0 8px;color:var(--wine-deep)}\n  .qa p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n  .qa p + p{margin-top:8px}\n\n  /* 页脚 */\n  footer{background:var(--wine-deep);color:#e8d9c8;padding:40px 0 48px;font-size:14px}\n  footer h2{color:#fbf4e8;font-size:18px;margin:0 0 12px}\n  footer p{margin:0 0 10px;max-width:66ch;color:#dcc9b8}\n  footer .jump{margin:18px 0 0;font-size:14px}\n  footer a{color:#fbf4e8;border-bottom:1px solid rgba(251,244,232,.45)}\n  footer .jump span.sep{color:#b98d84;padding:0 8px}\n\n  /* 清单 */\n  .checklist{list-style:none;margin:0;padding:0;font-size:15px;max-width:70ch}\n  .checklist li{border-bottom:1px dashed var(--line);padding:9px 0 9px 18px;position:relative;color:#3c322c}\n  .checklist li:last-child{border-bottom:0}\n  .checklist li::before{content:\"—\";position:absolute;left:0;color:var(--accent)}\n\n  @media (max-width:860px){\n    .dash{grid-template-columns:repeat(2,1fr)}\n    .three{grid-template-columns:1fr}\n    .steps{grid-template-columns:repeat(2,1fr)}\n    .ladder{grid-template-columns:1fr}\n    .rung-1,.rung-2,.rung-3{margin-top:0}\n    .client-list{grid-template-columns:1fr}\n  }\n  @media (max-width:520px){\n    .hero{padding:36px 0 44px}\n    section{padding:42px 0}\n    .dash{grid-template-columns:1fr}\n    .steps{grid-template-columns:1fr}\n    .dash-cell .value{font-size:23px}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">订阅说明 · 逐条列出</p>\n      <h1>微观云：三档套餐、一份客户端说明，先把条件摊开再决定</h1>\n      <p class=\"lead\">\n        这页不绕弯子。价格、每月流量、同时在线设备数、线路类型，全部按档位写清。\n        先看四个数字块，再往下核对套餐、流程和常见问题。\n      </p>\n\n      <div class=\"dash\">\n        <div class=\"dash-cell\">\n          <span class=\"label\">套餐档位</span>\n          <span class=\"value\">3 档</span>\n          <span class=\"note\">基础版 / 旗舰版 / 团队版</span>\n        </div>\n        <div class=\"dash-cell\">\n          <span class=\"label\">入门月付</span>\n          <span class=\"value\">¥15</span>\n          <span class=\"note\">按年付 ¥150 / 年</span>\n        </div>\n        <div class=\"dash-cell\">\n          <span class=\"label\">旗舰年付</span>\n          <span class=\"value\">¥350</span>\n          <span class=\"note\">折合每月约 ¥29.2</span>\n        </div>\n        <div class=\"dash-cell\">\n          <span class=\"label\">团队设备数</span>\n          <span class=\"value\">20 台</span>\n          <span class=\"note\">团队版同时在线上限</span>\n        </div>\n      </div>\n\n      <p class=\"hero-links\">\n        跳到：\n        <a href=\"#plans\">套餐对照</a><span class=\"sep\">/</span><a href=\"#clients\">客户端说明</a><span class=\"sep\">/</span><a href=\"#flow\">接入流程</a><span class=\"sep\">/</span><a href=\"#faq\">常见问题</a>\n      </p>\n    </div>\n  </header>\n\n  <section id=\"intro\">\n    <div class=\"wrap\">\n      <h2>这页适合谁，先对号入座</h2>\n      <p class=\"section-note\">\n        微观云的信息按“你每月用多少、几台设备、是否需要专线”三件事组织。\n        如果你的情况能直接对上下面的某一类，可以跳过叙述，直接看套餐表。\n      </p>\n      <div class=\"three\">\n        <div class=\"ticket\">\n          <div class=\"stub\"><span>情形一</span><span>轻度使用</span></div>\n          <h3>一两台设备，日常浏览</h3>\n          <p>每月流量需求在一百 GB 量级，主要是网页、文档和常规流媒体。基础版的 100GB 与 3 台设备通常够用。</p>\n        </div>\n        <div class=\"ticket\">\n          <div class=\"stub\"><span>情形二</span><span>多设备常在</span></div>\n          <h3>手机、平板、笔电同时用</h3>\n          <p>需要流媒体完整解锁与线路优先级更高时，旗舰版的 300GB、5 台设备与 IPLC 专线游戏加速优化是主要差异点。</p>\n        </div>\n        <div class=\"ticket\">\n          <div class=\"stub\"><span>情形三</span><span>小团队共用</span></div>\n          <h3>多人分摊，需要定制路由</h3>\n          <p>团队版把流量提到 1000GB、设备数放到 20 台，并提供 VIP 专属高带宽节点、企业定制路由与专属客户经理。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <h2>套餐对照：三档按阶梯排列，越往下承载力越大</h2>\n      <p class=\"section-note\">\n        下面每一档都标出月付价格、年付价格和权益清单。年付只是支付周期的差别，\n        权益内容与同档月付一致。以下为页面展示的价格，实际开通以你确认的页面为准。\n      </p>\n\n      <div class=\"ladder\">\n        <article class=\"rung rung-1\">\n          <span class=\"tier-no\">第一档</span>\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<span> / 月</span></p>\n          <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"rung rung-2\">\n          <span class=\"tier-no\">第二档</span>\n          <h3>旗舰版<span class=\"flag\">推荐</span></h3>\n          <p class=\"price\">¥35<span> / 月</span></p>\n          <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"rung rung-3\">\n          <span class=\"tier-no\">第三档</span>\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<span> / 月</span></p>\n          <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n\n      <p class=\"ladder-foot\">\n        <strong>怎么选：</strong>先看每月流量，再看同时在线设备数，最后看是否需要 IPLC 专线与定制路由。\n        三项里有两项落进同一档，就按那一档看；年付与否只影响结算周期，不改变权益内容。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <h2>客户端说明：按设备类型各写一段</h2>\n      <p class=\"section-note\">\n        客户端的具体下载地址与版本号请以你实际收到的页面或说明为准，本页不提供下载链接，\n        也不对未核实的兼容范围作承诺。下面只写使用上需要先知道的事。\n      </p>\n      <div class=\"client-list\">\n        <div class=\"ticket\">\n          <div class=\"stub\"><span>桌面端</span><span>Windows / macOS</span></div>\n          <h3>桌面客户端</h3>\n          <p>适合长时间在线的工作场景。安装后按订阅信息填入配置即可，切换节点在客户端内完成，不需要改动系统设置。</p>\n          <p class=\"meta\">下载地址：<a href=\"#\">以开通后页面给出的说明为准</a></p>\n        </div>\n        <div class=\"ticket\">\n          <div class=\"stub\"><span>移动端</span><span>iOS / Android</span></div>\n          <h3>移动客户端</h3>\n          <p>移动端更看重待机与切换速度。建议只保留常用节点列表，避免在弱网环境下反复重连。</p>\n          <p class=\"meta\">下载地址：<a href=\"#\">以开通后页面给出的说明为准</a></p>\n        </div>\n        <div class=\"ticket\">\n          <div class=\"stub\"><span>路由器</span><span>自备设备</span></div>\n          <h3>路由器侧接入</h3>\n          <p>若在路由器上统一配置，设备数按实际联网设备计入同时在线限制。团队版 20 台的额度通常用在这一层。</p>\n          <p class=\"meta\">配置方式：<a href=\"#\">见开通后随附的接入说明</a></p>\n        </div>\n        <div class=\"ticket\">\n          <div class=\"stub\"><span>账号</span><span>多设备登录</span></div>\n          <h3>同一账号的设备管理</h3>\n          <p>同时在线台数按档位限制：基础版 3 台、旗舰版 5 台、团队版 20 台。超出时先下线不用的设备再连。</p>\n          <p class=\"meta\">相关说明：<a href=\"#faq\">见常见问题中的设备主题</a></p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"flow\">\n    <div class=\"wrap\">\n      <h2>接入流程：四步，按顺序做</h2>\n      <p class=\"section-note\">每一步只做一件事，做完再进下一步，出问题时也容易定位在哪一环。</p>\n      <ol class=\"steps\">\n        <li>\n          <h3>选档</h3>\n          <p>按流量、设备数、线路三项确定基础版、旗舰版或团队版，再决定月付或年付。</p>\n        </li>\n        <li>\n          <h3>确认结算周期</h3>\n          <p>月付与年付权益一致，年付按 150 / 350 / 850 元一次性结算，适合长期不换档的情况。</p>\n        </li>\n        <li>\n          <h3>装客户端</h3>\n          <p>按设备类型选桌面端、移动端或路由器侧配置，填入订阅信息后先连一次做验证。</p>\n        </li>\n        <li>\n          <h3>核对用量</h3>\n          <p>连上后看一眼当月流量与在线设备数，确认没有超出所选档位再投入日常使用。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section id=\"notes\">\n    <div class=\"wrap\">\n      <h2>使用前值得逐条确认的六件事</h2>\n      <p class=\"section-note\">这些是实际使用中最容易出岔子的地方，先看一眼，能省掉一次工单。</p>\n      <ul class=\"checklist\">\n        <li>同时在线设备数按档位上限计算，退出一台才会空出一个位置。</li>\n        <li>流量按自然月刷新，跨月不累计，月底前的余量不会留到下个月。</li>\n        <li>流媒体解锁在基础版为“基础流媒体”，全节点原生解锁属于旗舰版及以上。</li>\n        <li>IPLC 专线游戏加速优化只出现在旗舰版与更高档位，基础版为普通线路节点池。</li>\n        <li>企业定制路由只在团队版提供，需要与专属客户经理对接具体配置。</li>\n        <li>本页不提供下载链接与交易入口，开通与下载请以你实际收到的页面说明为准。</li>\n      </ul>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <h2>常见问题：按主题分组</h2>\n      <p class=\"section-note\">问题按主题分三组：套餐与价格、设备与客户端、流量与线路。每组下面的答案直接写在页面上，不需要再点开。</p>\n\n      <div class=\"faq-group\">\n        <h3>一 · 套餐与价格</h3>\n\n        <div class=\"qa\">\n          <h4>年付比月付便宜多少？</h4>\n          <p>基础版月付 15 元、年付 150 元，正好是十个月的价钱；旗舰版月付 35 元、年付 350 元；团队版月付 85 元、年付 850 元。三档都是同一个规则：年付按十个月计。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>年付和月付的权益有区别吗？</h4>\n          <p>没有。年付只是把结算周期拉长，同一档位的流量、设备数、节点与支持内容完全一致。差别只在付款方式与总额。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>中途想换档怎么办？</h4>\n          <p>换档按当时的档位与结算周期处理。本页不承诺任何折算或差价规则，具体方式请以开通后页面给出的说明为准，不要按本页价格自行推算。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>为什么旗舰版被标为推荐？</h4>\n          <p>因为它在三档里是流量与设备数的中间点：300GB 与 5 台设备覆盖大多数多设备场景，同时带有全节点原生流媒体解锁与 IPLC 专线游戏加速优化。这是页面上的选择提示，不是使用效果承诺。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>二 · 设备与客户端</h3>\n\n        <div class=\"qa\">\n          <h4>同时在线的台数是怎么算的？</h4>\n          <p>按同时处于连接状态的设备数计算：基础版 3 台、旗舰版 5 台、团队版 20 台。手机、平板、笔记本各自算一台；若在路由器上统一配置，接在该路由器下的联网设备按实际数量计入。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>超出设备上限会怎样？</h4>\n          <p>通常表现为新设备连不上或旧连接被挤下线。处理办法是先在不用的设备上断开，再连新设备；如果长期不够用，说明当前档位偏低，应往上一档看。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>客户端从哪里获得？</h4>\n          <p>本页不提供下载地址，也不提供安装包。请以你开通后收到的页面说明为准，不要从本页以外的来源推断版本或兼容范围。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>只在一台电脑上用，需要看客户端那一段吗？</h4>\n          <p>需要看，但只看桌面端那一条即可。桌面端一条写清了填入配置与切换节点的位置，其余部分与单设备使用关系不大。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>三 · 流量与线路</h3>\n\n        <div class=\"qa\">\n          <h4>流量用超了会怎样？</h4>\n          <p>流量按自然月计算，用尽后当月无法继续按原额度使用。本页不承诺任何超出后的处理方式，请按所选档位的额度规划用量，接近上限时考虑换到更高一档。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>“普通线路节点池”和“VIP 专属高带宽节点”差在哪？</h4>\n          <p>按页面写法，基础版使用普通线路节点池；团队版使用 VIP 专属高带宽节点。旗舰版的特征是 IPLC 专线游戏加速优化。本页不对具体带宽数值或节点数量作说明，因为这些参数未在页面上给出。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>流媒体解锁三档有什么不同？</h4>\n          <p>基础版为“解锁基础流媒体”，旗舰版与团队版为“全节点原生流媒体解锁”。如果你的主要用途是流媒体，这一项是基础版与旗舰版之间的实质差别。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>团队版的企业定制路由需要额外付费吗？</h4>\n          <p>本页只写明团队版“支持企业定制路由”并提供“专属客户经理服务”，没有给出是否另计费用。这部分需与客户经理确认，本页不做价格推断。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <footer>\n    <div class=\"wrap\">\n      <h2>微观云 · 页面说明</h2>\n      <p>本页只做信息陈列：三档套餐的价格与权益、客户端使用方向、四步接入流程与按主题分组的常见问题。页面不提供下载链接与交易入口，也不对未列出的参数作承诺。</p>\n      <p>价格与权益以本页所列内容为准；开通与下载请以你实际收到的页面说明为准。</p>\n      <p class=\"jump\">\n        回到：\n        <a href=\"#plans\">套餐对照</a><span class=\"sep\">/</span><a href=\"#clients\">客户端说明</a><span class=\"sep\">/</span><a href=\"#flow\">接入流程</a><span class=\"sep\">/</span><a href=\"#faq\">常见问题</a>\n      </p>\n    </div>\n  </footer>\n\n</main>",
